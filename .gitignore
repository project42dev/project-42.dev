# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tmp_*/
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# --- The front-end application, installed from @project42/platform ------------
# This repository is branding, configuration and release records. The rendering
# application -- routes, components, the design system, the build toolchain and
# the gates that police them -- is product, lives in project42-platform/web, and
# is written here by `project42-portal materialise` from the postinstall hook.
#
# These are build inputs, not source. Change them upstream. The materialiser
# refuses to overwrite anything git tracks, so un-ignoring a path here is also
# how a deliberate fork is declared -- and it is a fork you then own.
/app/
/copy/
/lib/
/worker/
/scripts/*
!/scripts/mint-github-app-token.mjs
/tests/*
!/tests/production/
/eslint.config.mjs
/next.config.ts
/playwright.config.ts
/playwright.pages.config.ts
/postcss.config.mjs
/tsconfig.json
/vite.config.ts

# The theme bundle the platform SHIPS is materialised here on every install,
# exactly like app/ above -- change it upstream. The Gallery-synced bundles
# beside it are tracked on purpose: those are this deployment's own choices,
# hash-locked in config/theme-bundles.lock.json. Tracking a platform-shipped
# bundle would freeze it, because materialise reads a tracked bundle as
# vendored and refuses to refresh it.
/public/themes/portal-default/
